{
  "name": "offsetdock",
  "productName": "OffsetDock",
  "version": "0.1.1",
  "author": {
    "name": "Kinshuk Dutta",
    "email": "hello@data4ai.org"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/KinshukON/offsetdock.git"
  },
  "description": "A local-first macOS operations cockpit for Apache Kafka.",
  "main": "./out/main/index.js",
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0"
  },
  "desktopName": "offsetdock.desktop",
  "scripts": {
    "predev": "node scripts/patch-dev-app-name.mjs",
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "build": "electron-vite build",
    "build:mac": "node scripts/package-production.mjs --mac --publish never",
    "build:win": "node scripts/package-production.mjs --win --publish never",
    "build:linux": "node scripts/package-production.mjs --linux --publish never",
    "build:dir": "node scripts/package-production.mjs --dir",
    "postinstall": "electron-builder install-app-deps && node scripts/patch-dev-app-name.mjs"
  },
  "dependencies": {
    "@msgpack/msgpack": "^3.1.3",
    "ajv": "^8.20.0",
    "avsc": "^5.7.9",
    "aws-msk-iam-sasl-signer-js": "^1.0.2",
    "better-sqlite3": "^12.11.1",
    "bson": "^7.3.4",
    "cbor-x": "^1.6.9",
    "electron-updater": "^6.8.9",
    "fast-xml-parser": "^5.12.1",
    "kafkajs": "^2.2.4",
    "protobufjs": "^8.8.1"
  },
  "devDependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.13.9",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.15.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^43.8.13",
    "electron-builder": "^26.18.1",
    "electron-vite": "^5.0.0",
    "monaco-editor": "^0.52.2",
    "playwright-core": "^1.61.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "typescript": "^5.9.3",
    "vite": "^7.3.8",
    "vitest": "^4.1.12",
    "zustand": "^5.0.14"
  }
}
